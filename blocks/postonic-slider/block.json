{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "yearmfew-blocks/postonic-slider",
    "version": "0.1.0",
    "title": "Postonic Slider",
    "category": "yearmfew-blocks",
    "icon": "slides",
    "description": "Display posts in a slider layout with Swiper.js",
    "supports": {
        "html": false
    },
    "textdomain": "yearmfew-blocks",
    "editorScript": "file:../../build/postonic-slider/index.js",
    "editorStyle": "file:../../build/postonic-slider/index.css",
    "style": "file:../../build/postonic-slider/view.css",
    "viewScript": "file:../../build/postonic-slider/view.js",
    "render": "file:./src/render.php",
    "attributes": {
        "category": {
            "type": "string",
            "default": ""
        },
        "postsToShow": {
            "type": "number",
            "default": 6
        },
        "postCount": {
            "type": "string",
            "default": ""
        },
        "slidesPerView": {
            "type": "number",
            "default": 3
        },
        "showTitle": {
            "type": "boolean",
            "default": true
        },
        "showImage": {
            "type": "boolean",
            "default": true
        },
        "showContent": {
            "type": "boolean",
            "default": true
        },
        "showAuthor": {
            "type": "boolean",
            "default": true
        },
        "showDate": {
            "type": "boolean",
            "default": true
        },
        "showShare": {
            "type": "boolean",
            "default": true
        },
        "showPagination": {
            "type": "boolean",
            "default": true
        },
        "showNavigation": {
            "type": "boolean",
            "default": true
        }
    }
}